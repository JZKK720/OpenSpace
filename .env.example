# GHCR image defaults for pull-first releases.
# Set OPENSPACE_IMAGE_TAG to a release tag like v0.6.1 to pin a rollout.
# The same registry/tag pair also selects the mirrored GHCR base images used by -LocalBuild.
OPENSPACE_IMAGE_REGISTRY=ghcr.io/jzkk720
OPENSPACE_IMAGE_TAG=main

# Docker Compose defaults for the OpenSpace web surfaces

CUBECLOUD_PORT=7788
AGENTS_MONITOR_PORT=5173

# IronClaw browser-facing and container-facing URLs
IRONCLAW_PUBLIC_URL=http://127.0.0.1:3231/
IRONCLAW_INTERNAL_URL=http://host.docker.internal:3231/
IRONCLAW_HEALTH_URL=http://host.docker.internal:3231/
IRONCLAW_ACTION_URL=http://host.docker.internal:3231/api/chat/send

# Set one of these to the IronClaw gateway bearer token used by /api/chat/*.
IRONCLAW_AUTH_TOKEN=
GATEWAY_AUTH_TOKEN=

# Only set this if your IronClaw runtime exposes a real MCP endpoint.
IRONCLAW_MCP_URL=

# OpenHuman browser link plus internal worker (JSON-RPC on /rpc; optional host-local debug port 7181)
OPENHUMAN_PUBLIC_URL=http://127.0.0.1:1420/
OPENHUMAN_INTERNAL_URL=http://openhuman:7788/
OPENHUMAN_HEALTH_URL=http://openhuman:7788/health
OPENHUMAN_ACTION_URL=http://openhuman:7788/rpc
OPENHUMAN_RPC_TOKEN=change-me-openhuman-rpc
OPENHUMAN_CORE_IMAGE_TAG=latest
OPENHUMAN_DEBUG_PORT=7181

# Hermes agent (browser-facing UI on port 9119; OpenAI-compat API stays on port 8789)
HERMES_PUBLIC_URL=http://127.0.0.1:9119/
HERMES_INTERNAL_URL=http://host.docker.internal:8789/
HERMES_HEALTH_URL=http://host.docker.internal:8789/health
HERMES_ACTION_URL=http://host.docker.internal:8789/v1/chat/completions
HERMES_API_KEY=

# AgentOS / AionUi app surface
# AIONUI_PUBLIC_URL: browser-accessible AgentOS / AionUi web UI
# AIONUI_INTERNAL_URL: container-reachable AionUi target for health checks
# AIONUI_HEALTH_URL: health probe target used by the dashboard app registry
AIONUI_PUBLIC_URL=http://127.0.0.1:3308/
AIONUI_INTERNAL_URL=http://host.docker.internal:3308/
AIONUI_HEALTH_URL=http://host.docker.internal:3308/
# Optional: host folder, exported conversation JSON, live data directory, or aionui.db path for sync_aionui_workflows.py.
AIONUI_WORKFLOWS_SOURCE_DIR=logs/imports/aionui

# Open Design app surface
# OPEN_DESIGN_PUBLIC_URL: browser-accessible CubeCloud Open Design web UI
# OPEN_DESIGN_INTERNAL_URL: container-reachable Open Design web target for health checks
# OPEN_DESIGN_HEALTH_URL: health probe target used by the dashboard app registry
OPEN_DESIGN_PUBLIC_URL=http://127.0.0.1:7831/
OPEN_DESIGN_INTERNAL_URL=http://host.docker.internal:7831/
OPEN_DESIGN_HEALTH_URL=http://host.docker.internal:7831/
